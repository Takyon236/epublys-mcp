{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.epublys/epublys",
  "title": "Epublys",
  "description": "EPUB/PDF tools: merge, split, compress, convert, edit metadata, validate ebooks.",
  "version": "1.0.1",
  "websiteUrl": "https://epublys.com",
  "repository": {
    "url": "https://github.com/Takyon236/epublys-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://epublys.com/mcp",
      "headers": [
        { "name": "Authorization", "value": "Bearer <YOUR_API_KEY>" }
      ]
    }
  ]
}
